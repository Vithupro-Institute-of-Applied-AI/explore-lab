{
  "name": "VithuPro lab (cloud backup)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "uv sync && echo 'Run: uv run vp setup  then  uv run vp check'",
  "customizations": { "vscode": { "extensions": ["ms-python.python", "ms-toolsai.jupyter", "github.copilot"] } },
  "forwardPorts": [8000, 8501]
}
